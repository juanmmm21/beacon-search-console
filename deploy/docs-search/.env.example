# Dominio público (HTTPS automático). ":80" = HTTP plano para pruebas locales.
BEACON_DOMAIN=:80
# Hosts que el endpoint MCP acepta (protección DNS rebinding del SDK de MCP).
# En producción, el dominio público: docs.example.com,docs.example.com:*
BEACON_MCP_ALLOWED_HOSTS=localhost,localhost:*,api:8000
# 1 = BM25 + denso + cross-encoder disponible (~1 GB más de RAM); 0 = solo BM25.
BEACON_DOCS_HYBRID=1
# Límite por IP: 2 peticiones/s sostenidas, ráfagas de 30.
BEACON_RATE_PER_SECOND=2
BEACON_RATE_BURST=30
# Re-rastreo completo de las fuentes, en horas.
BEACON_REFRESH_HOURS=168

# Frontend estático + proxy inverso con HTTPS automático (Caddy).
FROM node:22-alpine AS build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine
COPY deploy/docs-search/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /frontend/dist /srv
